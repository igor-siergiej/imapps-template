{
  "name": "@__APP_NAME__/api",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "bun --watch src/index.ts",
    "start:e2e": "bun src/index.ts",
    "build": "bun build src/index.ts --outfile build/index.js --target bun --minify",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:integration": "docker compose -f ../../docker-compose.test.yml up -d --wait && RUN_INTEGRATION_TESTS=1 bun test integration; docker compose -f ../../docker-compose.test.yml down"
  },
  "dependencies": {
    "@__APP_NAME__/types": "workspace:*",
    "@imapps/api-utils": "7.0.0",
    "hono": "^4.13.17",
    "mongodb": "^7.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
